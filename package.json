{
  "name": "jushou",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply jushou-db --local && vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler d1 migrations apply jushou-db --remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
