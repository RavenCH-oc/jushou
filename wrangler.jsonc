{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jushou",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jushou-db",
      "database_id": "cdb26957-58a3-4587-b51c-661dfa08ae69",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LESSON_HUB", "class_name": "LessonHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LessonHub"] }],
  "observability": { "enabled": true }
}
